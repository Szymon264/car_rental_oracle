    vehicle_types [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B85C0E" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#B85C0E" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>VEHICLE_TYPES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="vehicle_type_id"><B>vehicle_type_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#2F5D8A" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="make_id">make_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="model_name">model_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(50)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="production_year">production_year</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(4)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(10)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="daily_rate">daily_rate</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(8,2)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="seating_capacity">seating_capacity</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(2)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="max_load_kg"><FONT COLOR="#5A6474">max_load_kg</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(5)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="cargo_capacity_m3"><FONT COLOR="#5A6474">cargo_capacity_m3</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(5,1)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="fuel_type">fuel_type</TD><TD ALIGN="LEFT"><FONT COLOR="#