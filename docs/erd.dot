digraph ERD {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=0.9, newrank=true, bgcolor="#F7F6F2", fontname="DejaVu Sans", pad=0.4];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=12];
  edge [color="#5A6474", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.3];
  subgraph cluster_0 { label="Słowniki"; fontname="DejaVu Sans"; fontsize=16; fontcolor="#6B7A8F"; color="#6B7A8F"; style="rounded,dashed"; penwidth=1.2;
    makes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7A8F" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#6B7A8F" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>MAKES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="make_id"><B>make_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="make_name">make_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(50)</FONT></TD></TR></TABLE>>];
    maintenance_types [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7A8F" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#6B7A8F" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>MAINTENANCE_TYPES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="maintenance_type_id"><B>maintenance_type_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="type_name">type_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(60)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="interval_km"><FONT COLOR="#5A6474">interval_km</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(7)</FONT></TD></TR></TABLE>>];
    promotions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6B7A8F" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#6B7A8F" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>PROMOTIONS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="promotion_id"><B>promotion_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="promo_code">promo_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(20)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#5A6474">description</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(200)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="discount_percent">discount_percent</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(5,2)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="valid_from">valid_from</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="valid_to">valid_to</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 { label="Ludzie i oddziały"; fontname="DejaVu Sans"; fontsize=16; fontcolor="#2F5D8A"; color="#2F5D8A"; style="rounded,dashed"; penwidth=1.2;
    users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2F5D8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#2F5D8A" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>USERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="user_id"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(40)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(60)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="middle_name"><FONT COLOR="#5A6474">middle_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(40)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="street">street</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(100)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="city">city</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(60)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="region">region</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(40)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="zip_code">zip_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(10)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="country">country</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(40)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="date_of_birth">date_of_birth</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(254)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="phone_number">phone_number</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(15)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(255)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
    employees [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2F5D8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#2F5D8A" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>EMPLOYEES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="user_id"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#2F5D8A" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="branch_id">branch_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="monthly_salary">monthly_salary</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(10,2)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="pesel">pesel</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">char(11)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="employee_role">employee_role</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(10)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="hire_date">hire_date</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
    customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2F5D8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#2F5D8A" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>CUSTOMERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="user_id"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="drivers_license_no">drivers_license_no</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(20)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="license_issue_date">license_issue_date</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
