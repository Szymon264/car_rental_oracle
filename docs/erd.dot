IZE="10">date</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="start_mileage"><FONT COLOR="#5A6474">start_mileage</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(8)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="end_mileage"><FONT COLOR="#5A6474">end_mileage</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(8)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="total_cost"><FONT COLOR="#5A6474">total_cost</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(10,2)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
    payment_details [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#14213D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#14213D" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>PAYMENT_DETAILS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="payment_details_id"><B>payment_details_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#2F5D8A" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="card_type">card_type</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(12)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="card_last4">card_last4</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">char(4)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="card_holder_name">card_holder_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(100)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="expiry_date">expiry_date</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
    transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#14213D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#14213D" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>TRANSACTIONS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="transaction_id"><B>transaction_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#2F5D8A" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="booking_id">booking_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#2F5D8A" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="payment_details_id">payment_details_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="amount">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(10,2)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="transaction_date">transaction_date</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="payment_method">payment_method</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(10)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="transaction_type">transaction_type</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(12)</FONT></TD></TR></TABLE>>];
    damages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#14213D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#14213D" ALIGN="CENTER" COLSPAN="3"><FONT COLOR="#F7F6F2" POINT-SIZE="15"><B>DAMAGES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B85C0E" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="damage_id"><B>damage_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#2F5D8A" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="booking_id">booking_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(400)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="severity">severity</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">varchar2(6)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="repair_cost"><FONT COLOR="#5A6474">repair_cost</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">number(10,2)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="charged_to_customer">charged_to_customer</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">char(1)</FONT></TD></TR><TR><TD WIDTH="26"> </TD><TD ALIGN="LEFT" PORT="reported_date">reported_date</TD><TD ALIGN="LEFT"><FONT COLOR="#5A6474" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
  }
  makes -> vehicle_types;
  users -> employees;
  branches -> employees;
  users -> customers;
  branches -> vehicles;
  vehicle_types -> vehicles;
  customers -> bookings;
  vehicles -> bookings;
  employees -> bookings;
  promotions -> bookings;
  customers -> payment_details;
  bookings -> transactions;
  payment_details -> transactions;
  bookings -> damages;
